# Copy to .env.local and fill in development/test values.
# Production values are set in Vercel's environment variable settings —
# never commit real secrets to this repo.

NEXT_PUBLIC_APP_ENV=
NEXT_PUBLIC_BASE_URL=
FOUNDER_EMAIL=

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_GROWTH_PRICE_ID=
SUB_WEBHOOK_SECRET=
CONNECTED_ACCOUNT_WEBHOOK_SECRET=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ROLE_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_CONNECTION_STRING=

# Email
RESEND_API_KEY=

# Scheduling
TRIGGER_API_KEY=

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_ANALYTICS_API_SECRET=
ANALYTICS_PROPERTY_ID=
GOOGLE_ANALYTICS_KEY=

# Other third-party keys
GOOGLE_MAPS_KEY=
NEXT_PUBLIC_GOOGLE_FONTS_API_KEY=
NEXT_PUBLIC_MAILCHIMP_API_KEY=
NEXT_PUBLIC_SECRET=

# Business booking subdomains (kayla.afroallure.co). Leave unset to use /business/<name> paths.
# Locally, set to localhost:3000 and open http://<url_name>.localhost:3000
NEXT_PUBLIC_BOOKING_ROOT_DOMAIN=
